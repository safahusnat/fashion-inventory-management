@model FashionInventoryManagement.ViewModels.InventoryDashboardViewModel
@{
    ViewData["Title"] = "Inventory Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="hero p-4 mb-4 rounded-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <p class="text-uppercase text-muted fw-semibold mb-1">Fashion Operations Dashboard</p>
            <h1 class="display-6 fw-bold mb-2">Fashion Inventory Management System</h1>
            <p class="mb-0">Manage stock, monitor low inventory and export product data from one clean dashboard.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-dark">Add Item</a>
            <a asp-action="ExportCsv" class="btn btn-outline-dark">Export CSV</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card stat"><div class="card-body"><h6>Total Products</h6><h3>@Model.TotalItems</h3></div></div></div>
    <div class="col-md-3"><div class="card stat low"><div class="card-body"><h6>Low Stock</h6><h3>@Model.LowStockItems</h3></div></div></div>
    <div class="col-md-3"><div class="card stat"><div class="card-body"><h6>Total Units</h6><h3>@Model.TotalStockUnits</h3></div></div></div>
    <div class="col-md-3"><div class="card stat"><div class="card-body"><h6>Stock Value</h6><h3>£@Model.TotalStockValue.ToString("N2")</h3></div></div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Search & Filter</h5>
                <form method="get" class="row g-2">
                    <div class="col-md-4">
                        <input class="form-control" name="search" value="@Model.Search" placeholder="Search item or brand" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="category">
                            <option value="">All categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category" selected="@(Model.Category == category)">@category</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="stockStatus">
                            <option value="">All stock</option>
                            <option value="low" selected="@(Model.StockStatus == "low")">Low stock</option>
                            <option value="healthy" selected="@(Model.StockStatus == "healthy")">Healthy stock</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button class="btn btn-dark">Apply</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Category Breakdown</h5>
                @foreach (var category in Model.CategoryBreakdown)
                {
                    var percentage = Model.TotalStockUnits == 0 ? 0 : (category.Value * 100 / Model.TotalStockUnits);
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small fw-semibold"><span>@category.Key</span><span>@category.Value units</span></div>
                        <div class="progress" role="progressbar" aria-label="@category.Key stock level">
                            <div class="progress-bar bg-dark" style="width: @percentage%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr><th>Name</th><th>Category</th><th>Brand</th><th>Size</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="@(item.IsLowStock ? "table-warning" : "")">
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Brand</td>
                    <td>@item.Size</td>
                    <td>£@item.Price.ToString("N2")</td>
                    <td>@item.StockQuantity</td>
                    <td>
                        @if (item.IsLowStock)
                        {
                            <span class="badge text-bg-warning">Reorder soon</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Healthy</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
