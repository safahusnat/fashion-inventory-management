@model IEnumerable<ClothingItem>
@{
    ViewData["Title"] = "Inventory";
}

<div class="hero p-4 mb-4 rounded-4">
    <h1 class="display-6 fw-bold">Fashion Inventory Management System</h1>
    <p class="mb-0">A C# ASP.NET Core MVC project for managing fashion stock, categories and low-stock alerts.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card stat"><div class="card-body"><h6>Total Items</h6><h3>@ViewBag.TotalItems</h3></div></div></div>
    <div class="col-md-4"><div class="card stat"><div class="card-body"><h6>Low Stock Items</h6><h3>@ViewBag.LowStockItems</h3></div></div></div>
    <div class="col-md-4"><div class="card stat"><div class="card-body"><h6>Total Stock Value</h6><h3>£@ViewBag.TotalStockValue</h3></div></div></div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search by item or brand" />
    </div>
    <div class="col-md-4">
        <select class="form-select" name="category">
            <option value="">All categories</option>
            <option>Clothing</option><option>Shoes</option><option>Jewellery</option><option>Accessories</option>
        </select>
    </div>
    <div class="col-md-3 d-grid">
        <button class="btn btn-dark">Search</button>
    </div>
</form>

<table class="table table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr><th>Name</th><th>Category</th><th>Brand</th><th>Size</th><th>Price</th><th>Stock</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr class="@(item.IsLowStock ? "table-warning" : "")">
            <td class="fw-semibold">@item.Name</td>
            <td>@item.Category</td>
            <td>@item.Brand</td>
            <td>@item.Size</td>
            <td>£@item.Price</td>
            <td>@item.StockQuantity @(item.IsLowStock ? "⚠️" : "")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
