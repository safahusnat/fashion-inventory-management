@model ClothingItem
<form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")" method="post" class="card p-4 shadow-sm">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option>Clothing</option><option>Shoes</option><option>Jewellery</option><option>Accessories</option></select></div>
        <div class="col-md-6"><label asp-for="Brand" class="form-label"></label><input asp-for="Brand" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Size" class="form-label"></label><input asp-for="Size" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="StockQuantity" class="form-label"></label><input asp-for="StockQuantity" class="form-control" /></div>
        <div class="col-12"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" /></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-dark">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
